{
  "name": "byggnytt",
  "version": "1.0.0",
  "private": true,
  "description": "Nyhetsbrevs-app för bygghandel",
  "workspaces": [
    "packages/shared",
    "packages/backend",
    "packages/frontend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev -w packages/backend\" \"npm run dev -w packages/frontend\"",
    "dev:backend": "npm run dev -w packages/backend",
    "dev:frontend": "npm run dev -w packages/frontend",
    "build": "npm run build -w packages/shared && npm run build -w packages/backend && npm run build -w packages/frontend",
    "lint": "eslint packages/*/src --ext .ts,.tsx",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "eslint": "^9.19.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  }
}
